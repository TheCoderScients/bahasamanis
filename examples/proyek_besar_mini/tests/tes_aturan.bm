pakai "../src/domain/aturan.bm" sebagai aturan

pastikan_sama(aturan.subtotal(12000, 3), 36000)
pastikan_sama(aturan.diskon(70000), 0)
pastikan_sama(aturan.diskon(75000), 5000)
pastikan_sama(aturan.diskon(150000), 15000)
pastikan_sama(aturan.total_setelah_diskon(150000), 135000)
